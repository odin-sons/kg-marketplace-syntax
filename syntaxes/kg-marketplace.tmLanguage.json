{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/refs/heads/master/tmlanguage.json",
    "name": "KG Marketplace",
    "patterns": [
        {
            "include": "#escapes"
        },
        {
            "include": "#strings"
        },
        {
            "begin": "^(Kill|Collect|Harvest|Craft|Talk|Build|Move|KillAndCollect|Use|Activate)\\s*$",
            "beginCaptures": {
                "1": { "name": "storage.type" }
            },
            "end": "^(.*\\S.*)$",
            "endCaptures": {
                "1": { "name": "entity.name.class" }
            }
        },
        {
            "include": "#operators"
        },
        {
            "match": "\\b(\\d+)\\b",
            "name": "constant.numeric"
        },
        {
            "include": "#quest-header-tags"
        },
        {
            "include": "#section"
        },
        {
            "include": "#color-tags"
        },
        {
            "include": "#image-tags"
        },
        {
            "include": "#html-tags"
        },
        {
            "include": "#variables"
        },
        {
            "include": "#quest-event-fields"
        },
        {
            "include": "#quest-reward-fields"
        },
        {
            "include": "#dialog-options"
        },
        {
            "include": "#territory-keywords"
        },
        {
            "include": "#territory-appearance-keys"
        },
        {
            "include": "#coordinates"
        },
        {
            "include": "#conditions"
        },
        {
            "include": "#commands"
        },
        {
            "include": "#dialogue-triggers"
        },
        {
            "include": "#comments"
        }
    ],
    "repository": {
        "escapes": {
            "patterns": [
                {
                    "match": "\\\\n",
                    "name": "constant.character.escape"
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "match": "\"[^\"]*\"",
                    "name": "string.quoted.double"
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "match": "\\|\\|",
                    "name": "keyword.operator.logical.or"
                },
                {
                    "match": "!(?=[A-Za-z])",
                    "name": "keyword.operator.logical.not"
                }
            ]
        },
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.number-sign",
                    "match": "#.*$"
                }
            ]
        },
        "section": {
            "patterns": [
                {
                    "name": "entity.name.section",
                    "match": "\\[(.*?)\\]"
                }
            ]
        },
        "quest-header-tags": {
            "patterns": [
                {
                    "match": "(\\[[^\\[\\]=]*=\\s*)(Autocomplete|HiddenAnyCondition|HiddenOtherQuestCondition)(\\s*\\])",
                    "captures": {
                        "1": { "name": "entity.name.section" },
                        "2": { "name": "constant.language" },
                        "3": { "name": "entity.name.section" }
                    }
                }
            ]
        },
        "dialog-options": {
            "patterns": [
                {
                    "begin": "(Text|Transition|RandomTransition|Command|RandomCommand|Icon|Condition|AlwaysVisible|Color|OverrideError):\\s*",
                    "end": "(?=\\s*\\||$)",
                    "beginCaptures": {
                        "1": {
                            "name": "keyword.control"
                        }
                    },
                    "contentName": "string.unquoted",
                    "patterns": [
                        { "include": "#escapes" },
                        { "include": "#strings" },
                        { "include": "#operators" },
                        { "include": "#color-tags" },
                        { "include": "#image-tags" },
                        { "include": "#html-tags" },
                        { "include": "#variables" },
                        { "include": "#conditions" },
                        { "include": "#commands" }
                    ]
                },
                {
                    "match": "\\|(?=\\s*(?:Text|Transition|RandomTransition|Command|RandomCommand|Icon|Condition|AlwaysVisible|Color|OverrideError):)",
                    "name": "keyword.operator.separator"
                },
                {
                    "match": "([A-Z]\\w*)(?=:)",
                    "name": "entity.other.attribute-name"
                }
            ]
        },
        "dialogue-triggers": {
            "patterns": [
                {
                    "match": "^(@interaction|@onopen|@inrange|@outrange)\\b",
                    "name": "keyword.control.trigger"
                }
            ]
        },
        "quest-event-fields": {
            "patterns": [
                {
                    "match": "\\b(OnAcceptQuest|OnCancelQuest|OnCompleteQuest|OnQuestTimeout|OnDeath)(?=\\s*:)",
                    "name": "keyword.control.quest-event"
                }
            ]
        },
        "quest-reward-fields": {
            "patterns": [
                {
                    "match": "\\b(RandomItem|Item|Skill_EXP|Skill|Pet|EpicMMO_EXP|Cozyheim_EXP|Battlepass_EXP|RustyClasses_EXP|GuildAddLevel|SetCustomValue|AddCustomValue)(?=\\s*:)",
                    "name": "keyword.control.quest-reward"
                }
            ]
        },
        "territory-keywords": {
            "patterns": [
                {
                    "match": "\\b(Circle|Square|Rectangle)\\b",
                    "name": "storage.type.territory-shape"
                },
                {
                    "match": "\\b(PushAway|NoBuild|NoPickaxe|NoInteract|NoAttack|PvpOnly|PveOnly|PeriodicHeal|PeriodicDamage|IncreasedPlayerDamage|IncreasedMonsterDamage|NoMonsters|CustomEnvironment|MoveSpeedMultiplier|NoDeathPenalty|NoPortals|PeriodicHealALL|ForceGroundHeight|ForceBiome|AddGroundHeight|NoBuildDamage|MonstersAddStars|InfiniteFuel|NoInteractItems|NoInteractCraftingStation|NoInteractItemStands|NoInteractChests|NoInteractDoors|NoStructureSupport|NoInteractPortals|CustomPaint|LimitZoneHeight|NoItemLoss|SnowMask|NoMist|InfiniteEitr|InfiniteStamina|DropMultiplier|ForceWind|GodMode|OnlyForGuild|CustomJereSpawner|JoinOtherServer|RevealOnMap|OnlyForFaction)\\b",
                    "name": "constant.language"
                },
                {
                    "match": "\\b(FromCenter|ToCenter|LeftRight|RightLeft|TopBottom|BottomTop|BottomRightTopLeft|TopRightBottomLeft|BottomLeftTopRight|TopLeftBottomRight)\\b",
                    "name": "constant.language.gradient-direction"
                }
            ]
        },
        "territory-appearance-keys": {
            "patterns": [
                {
                    "match": "\\b(exp|heightbounds)(?=\\s*:)",
                    "name": "entity.other.attribute-name"
                }
            ]
        },
        "coordinates": {
            "patterns": [
                {
                    "match": "\\b\\d+\\s*,\\s*\\d+\\s*,\\s*\\d+\\b",
                    "name": "constant.numeric"
                }
            ]
        },
        "variables": {
            "patterns": [
                {
                    "match": "%\\w+%",
                    "name": "variable.language"
                }
            ]
        },
        "conditions": {
            "patterns": [
                {
                    "match": "\\b(HasItem|NotHasItem|HasBuff|NotHasBuff|SkillMore|SkillLess|GlobalKey|NotGlobalKey|HasQuest|NotHasQuest|QuestProgressDone|QuestProgressNotDone|QuestFinished|QuestNotFinished|EpicMMOLevelMore|EpicMMOLevelLess|CozyheimLevelMore|CozyheimLevelLess|RustyClassesLevelMore|RustyClassesLevelLess|HasAchievement|NotHasAchievement|HasAchievementScore|NotHasAchievementScore|CustomValueMore|CustomValueLess|ModInstalled|NotModInstalled|IronGateStatMore|IronGateStatLess|HasGuildWithName|NotHasGuildWithName|HasGuild|NotHasGuild|GuildLevelMore|GuildLevelLess|GuildHasAchievement|GuildNotHasAchievement|IsVIP|NotIsVIP|HasPlayerKey|NotHasPlayerKey|NPCModelEquals|NotNPCModelEquals|NPCNameEquals|NotNPCNameEquals|HasAnyFaction|NotHasAnyFaction|HasFaction|NotHasFaction|MaxHealthMore|MaxHealthLess|HealthMore|HealthLess|MaxStaminaMore|MaxStaminaLess|StaminaMore|StaminaLess|MaxEitrMore|MaxEitrLess|EitrMore|EitrLess|PlayerHasAllCustomDataKeys|PlayerHasOneOfCustomDataKeys)\\b",
                    "name": "support.function.condition"
                }
            ]
        },
        "commands": {
            "patterns": [
                {
                    "match": "\\b(OpenUI|PlaySound|GiveQuest|RemoveQuest|FinishQuest|GiveItemWithData|GiveItem|RemoveItem|SetPlayerData|SpawnXYZWithData|SpawnXYZ|SpawnWithData|Spawn|Teleport|Damage|Heal|GiveBuff|AddPin|PingMap|AddEpicMMOExp|AddCozyheimExp|AddRustyClassesEXP|PlayAnimation|EnterPassword|GuildAddLevel|Battlepass_EXP|ConsoleCommand|AddCustomValue|SetCustomValue|PlayVideo|SendWebhook|AddPlayerKey|RemovePlayerKey|SetPlayerGuildRank|SetPlayerGuild|SetNPCModelLocal|SetNPCModelGlobal|SetNPCNameLocal|SetNPCNameGlobal|SetNPCPatrol|AddFaction|RemoveFaction|RemoveAllFactions)\\b",
                    "name": "support.function.command"
                }
            ]
        },
        "color-tags": {
            "patterns": [
                {
                    "begin": "(<)(color)(=)(#[0-9A-Fa-f]{6})(>)",
                    "end": "(<\\/)(color)(>)",
                    "beginCaptures": {
                        "1": { "name": "punctuation.definition.tag.begin" },
                        "2": { "name": "entity.name.tag" },
                        "3": { "name": "punctuation.separator.key-value" },
                        "4": { "name": "constant.other.color.hex" },
                        "5": { "name": "punctuation.definition.tag.end" }
                    },
                    "endCaptures": {
                        "1": { "name": "punctuation.definition.tag.begin" },
                        "2": { "name": "entity.name.tag" },
                        "3": { "name": "punctuation.definition.tag.end" }
                    },
                    "name": "meta.tag.color",
                    "contentName": "markup.styled",
                    "patterns": [
                        { "include": "#color-tags" },
                        { "include": "#image-tags" },
                        { "include": "#html-tags" },
                        { "include": "#variables" }
                    ]
                }
            ]
        },
        "image-tags": {
            "match": "(<)(image)(=)([^>]*)(>)",
            "captures": {
                "1": { "name": "punctuation.definition.tag.begin" },
                "2": { "name": "entity.name.tag" },
                "3": { "name": "punctuation.separator.key-value" },
                "4": { "name": "string.unquoted.image-path" },
                "5": { "name": "punctuation.definition.tag.end" }
            }
        },
        "html-tags": {
            "patterns": [
                {
                    "begin": "(<)(b)(>)",
                    "end": "(<\\/)(b)(>)",
                    "beginCaptures": {
                        "1": { "name": "punctuation.definition.tag.begin" },
                        "2": { "name": "entity.name.tag" },
                        "3": { "name": "punctuation.definition.tag.end" }
                    },
                    "endCaptures": {
                        "1": { "name": "punctuation.definition.tag.begin" },
                        "2": { "name": "entity.name.tag" },
                        "3": { "name": "punctuation.definition.tag.end" }
                    },
                    "name": "markup.bold",
                    "patterns": [
                        { "include": "$self" }
                    ]
                },
                {
                    "begin": "(<)(i)(>)",
                    "end": "(<\\/)(i)(>)",
                    "beginCaptures": {
                        "1": { "name": "punctuation.definition.tag.begin" },
                        "2": { "name": "entity.name.tag" },
                        "3": { "name": "punctuation.definition.tag.end" }
                    },
                    "endCaptures": {
                        "1": { "name": "punctuation.definition.tag.begin" },
                        "2": { "name": "entity.name.tag" },
                        "3": { "name": "punctuation.definition.tag.end" }
                    },
                    "name": "markup.italic",
                    "patterns": [
                        { "include": "$self" }
                    ]
                },
                {
                    "begin": "(<)(size)(=)(\\d+)(>)",
                    "end": "(<\\/)(size)(>)",
                    "beginCaptures": {
                        "1" : {"name": "punctuation.definition.tag.begin"},
                        "2" : {"name": "entity.name.tag"},
                        "3" : {"name": "punctuation.separator.key-value"},
                        "4" : {"name": "constant.numeric"},
                        "5" : {"name": "punctuation.definition.tag.end"}
                    },
                    "endCaptures": {
                        "1": { "name": "punctuation.definition.tag.begin" },
                        "2": { "name": "entity.name.tag" },
                        "3": { "name": "punctuation.definition.tag.end" }
                    },
                    "name": "meta.tag.size",
                    "patterns": [
                        { "include": "$self" }
                    ]
                }
            ]
        }
    },
    "scopeName": "source.cfg"
}
